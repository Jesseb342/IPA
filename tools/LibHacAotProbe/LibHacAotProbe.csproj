<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <NativeLib>Static</NativeLib>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibHac" Version="0.19.0" />
    <Compile Remove="HostTest/**/*.cs" />
  </ItemGroup>

  <!--
    A NativeAOT static archive is not self-contained when consumed by an
    existing Xcode target. Export the exact native archives/frameworks that
    the .NET iOS LinkNative target uses so the app can link the complete
    runtime in the correct order.
  -->
  <Target Name="WriteParaboxNativeLinkInputs" BeforeTargets="LinkNative">
    <WriteLinesToFile
      File="$(MSBuildProjectDirectory)/native-link-inputs.txt"
      Lines="@(NativeLibrary->'LIB|%(Identity)')"
      Overwrite="true" />
    <WriteLinesToFile
      File="$(MSBuildProjectDirectory)/native-link-inputs.txt"
      Lines="@(NativeFramework->'FRAMEWORK|%(Identity)')"
      Overwrite="false" />
    <WriteLinesToFile
      File="$(MSBuildProjectDirectory)/native-link-inputs.txt"
      Lines="@(NativeSystemLibrary->'SYSTEM|%(Identity)')"
      Overwrite="false" />
  </Target>
</Project>
